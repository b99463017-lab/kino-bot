@dp.callback_query(F.data.startswith("check_sub"))
async def check_sub_callback(call: CallbackQuery):
    # Callback ma'lumotidan kino kodini ajratamiz (masalan: check_sub:101)
    movie_code = call.data.split(":")[1]
    movie_code = None if movie_code == "none" else movie_code

    sub_kb = await get_sub_keyboard(call.from_user.id, movie_code)
    
