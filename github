        await call.answer("❌ Hali barcha kanallarga obuna bo'lmadingiz!", show_alert=True)
    else:
        await call.message.delete()
        if movie_code:
            # Obuna bo'lgach, so'ralgan kinoni avtomatik yuboramiz
            await send_movie_by_code(call.message.chat.id, movie_code)
        else:
            start_text = await get_setting('start_text')
            await call.message.answer(f"✅ Rahmat! Obuna tasdiqlandi.\n\n{start_text}")


