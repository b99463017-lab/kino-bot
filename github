from aiogram.filters import CommandStart, CommandObject
from aiogram.types import Message, CallbackQuery, InlineKeyboardMarkup, InlineKeyboardButton

# BOT USERNAME'ni o'zingiznikiga almashtiring (boshida @ siz)
BOT_USERNAME = "SeningKinoBoting" 

# --- MAJBURIY OBUNA TEKSHIRUVI VA TUGMALAR ---
async def get_sub_keyboard(user_id: int, movie_code: str = None):
    # Bazadan kanallarni olamiz
    async with db.execute("SELECT id, link FROM channels") as cursor:
        channels = await cursor.fetchall()
        
    unsubbed = []
    btns = []
    
    for ch_id, ch_link in channels:
        try:
            member = await bot.get_chat_member(chat_id=ch_id, user_id=user_id)
            if member.status in ['left', 'kicked']:
                unsubbed.append((ch_link, "📢 Kanalga obuna bo'lish"))
        except Exception:
            unsubbed.append((ch_link, "📢 Kanalga obuna bo'lish"))

    # Agarda kanallar obunasi bajarilmagan bo'lsa, tugmalarni shakllantiramiz
    if unsubbed:
        for link, title in unsubbed:
            btns.append([InlineKeyboardButton(text=title, url=link)])
            
        # Instagram sahifa (Ixtiyoriy - tugmalar qatoriga qo'shiladi)
        # Baza yoki o'zgaruvchidan olsangiz ham bo'ladi
        INSTAGRAM_LINK = "https://instagram.com/instagram_profilingiz"
        btns.append([InlineKeyboardButton(text="📸 Instagramimizga a'zo bo'ling", url=INSTAGRAM_LINK)])
        
        # Check_sub tugmasiga kino kodini ham biriktirib ketamiz
        cb_data = f"check_sub:{movie_code}" if movie_code else "check_sub:none"
        btns.append([InlineKeyboardButton(text="✅ Obuna bo'ldim", callback_data=cb_data)])
        
        return InlineKeyboardMarkup(inline_keyboard=btns)
    
    return None # Barcha obunalar bajarilgan


