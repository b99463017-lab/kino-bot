async def send_movie_by_code(chat_id: int, code: str):
    async with db.execute("SELECT file_id, type FROM movies WHERE code=?", (code,)) as cursor:
        movie = await cursor.fetchone()
    
    if movie:
        file_id, m_type = movie
        
        # Telegram Share havolasi
        share_url = f"https://t.me/share/url?url=https://t.me/{BOT_USERNAME}?start={code}&text=🍿%20Ushbu%20kinoni%20tomosha%20qiling!"
        
        share_kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="🚀 Do'stlarga ulashish", url=share_url)]
        ])
        
        caption = f"🎬 <b>Kino kodi:</b> {code}\n\n🤖 @{BOT_USERNAME} orqali yuklab olindi."

        if m_type == "video":
            await bot.send_video(chat_id=chat_id, video=file_id, caption=caption, parse_mode="HTML", reply_markup=share_kb)
        else:
            await bot.send_document(chat_id=chat_id, document=file_id, caption=caption, parse_mode="HTML", reply_markup=share_kb)
    else:
        await bot.send_message(chat_id=chat_id, text=f"❌ <b>{code}</b> kodli kino topilmadi.", parse_mode="HTML")


